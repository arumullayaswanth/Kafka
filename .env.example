# Copy to .env:  cp .env.example .env
# Then set INTERNAL_API_TOKEN:  sed -i "s/^INTERNAL_API_TOKEN=.*/INTERNAL_API_TOKEN=$(openssl rand -hex 24)/" .env
KAFKA_UI_PORT=8080
FRONTEND_PORT=80
KAFKA_CLUSTER_NAME=kafka-cluster
TOPIC_NAME=orders
CONSUMER_GROUP_ID=order-processing-group
PRODUCE_INTERVAL_SECONDS=2

# Shared secret between consumer and backend (/internal/events). Required; generate a random value.
INTERNAL_API_TOKEN=
