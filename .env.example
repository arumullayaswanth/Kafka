# Copy to .env:  cp .env.example .env   (scripts/start.sh does this and generates the token)
KAFKA_UI_PORT=8080
FRONTEND_PORT=80
KAFKA_CLUSTER_NAME=kafka-cluster
TOPIC_NAME=orders

# Shared secret between consumers and backend (/internal/events). Required; generate a random value:
#   sed -i "s/^INTERNAL_API_TOKEN=.*/INTERNAL_API_TOKEN=$(openssl rand -hex 24)/" .env
INTERNAL_API_TOKEN=
